# Copy to .env.local for development. In production, set these in Vercel → Project → Settings → Environment Variables.

# ── Clerk (https://dashboard.clerk.com → API keys) ─────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/today
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/today

# ── Supabase Postgres (Project → Connect) ──────────────────────────────────────
# App: "Transaction pooler" connection string (port 6543)
DATABASE_URL=
# Migrations: "Session pooler" connection string (port 5432)
DIRECT_DATABASE_URL=

# ── Encryption ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with: npm run keygen
# Mark as "Sensitive" in Vercel. NEVER commit it and NEVER store it with database backups.
# If this key is lost, every memory becomes unreadable: keep a copy in a password manager.
YAADASHT_MASTER_KEY=

# ── Limits ─────────────────────────────────────────────────────────────────────
DEFAULT_STORAGE_QUOTA_BYTES=524288000
