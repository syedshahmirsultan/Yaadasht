# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ────────────────────────────────────────────────
/.next/
/out/
/build
/dist
.turbo
.vercel
*.tsbuildinfo
next-env.d.ts

# ── Secrets: never commit these ─────────────────────────────────
# .env.local holds the Clerk, Supabase and encryption master keys.
.env*
!.env.example
*.pem
*.key

# ── Tests & coverage ────────────────────────────────────────────
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# ── Logs & caches ───────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.cache

# ── Local databases and data dumps (may contain personal data) ──
*.db
*.sqlite
*.sqlite3
*.dump
/pgdata
/data

# ── Editors & tools (personal settings) ─────────────────────────
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── Operating systems ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
